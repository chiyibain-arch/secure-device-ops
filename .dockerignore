# Version control
.git
.gitignore
.github

# Editor / IDE
.vscode
.idea

# Local security/analysis tooling and its reports — must never enter the
# build context or be copied into the image
.kilo
.sonar
gitleaks-report.json
sbom.cdx.json
sbom-readable.json

# Python virtual environments and caches (dev-only, not runtime deps)
**/.venv
**/__pycache__
**/*.pyc
**/*.pyo

# Runtime artifacts generated by running the app/tools locally
**/*.db
**/*.log

# C++ device simulator — a separate component, not part of the API image
device-simulator
*.exe
*.obj
*.ilk
*.pdb
*.out

# Docs
README.md
